<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SCENOVA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/black_bg</item>
        <item name="android:navigationBarColor">@color/black_bg</item>
        <item name="android:windowBackground">@color/black_bg</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.SCENOVA.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/black_bg</item>
        <item name="android:navigationBarColor">@color/black_bg</item>
        <item name="android:windowBackground">@color/black_bg</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
